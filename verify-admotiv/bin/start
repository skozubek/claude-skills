#!/usr/bin/env bash
# Startuje dev serwer AdMotiv dla tego checkoutu na jego własnym porcie.
# Uruchamiaj przez Bash z run_in_background: proces żyje do `bin/sprzataj`.
set -euo pipefail
source "$(dirname "$0")/_wspolne.sh"

[ -x "$REPO/node_modules/.bin/vite" ] || { echo "BŁĄD: brak node_modules w $REPO. Najpierw: (cd $REPO && bun install)" >&2; exit 2; }
mkdir -p "$(dirname "$STAN_DIR")"
# Blokada: drugi start tego samego checkoutu odpada, zanim dotknie stanu pierwszego.
mkdir "$STAN_DIR" 2>/dev/null || { echo "BŁĄD: stan $STAN_DIR istnieje: serwer tego checkoutu już działa albo nie sprzątnięto. bin/doctor, potem bin/sprzataj." >&2; exit 3; }
if [ -n "$(pid_portu)" ]; then
  rmdir "$STAN_DIR"
  echo "BŁĄD: port $PORT zajęty przez pid $(pid_portu) z '$(cwd_procesu "$(pid_portu)")'. Nie ruszam cudzego procesu." >&2; exit 3
fi

echo $$ > "$STAN_DIR/serwer.pid"
echo "$REPO" > "$STAN_DIR/checkout"
echo "Serwer: $URL (checkout $REPO)"
cd "$REPO"
exec ./node_modules/.bin/vite --port "$PORT" --strictPort
