#!/usr/bin/env bash
# Czy tę instancję warto sterować? Tylko odczyt. Uruchamiasz przed pierwszym sterowaniem,
# po każdym nieudanym kroku i zawsze, gdy coś wygląda dziwnie.
# Kolejność: bin/start, bin/sesja <email>, bin/doctor. Bez sesji i bez karty na tym serwerze wynik to BŁĄD.
# Użycie: bin/doctor [obszar]   obszary dotknięte zmianą + cudze commity od ostatniego przejścia (obszar = wiersz meta/mapa/przejscia.tsv)
set -uo pipefail
source "$(dirname "$0")/_wspolne.sh"
cd "$REPO"
BLAD=0
ok()    { echo "OK     $*"; }
uwaga() { echo "UWAGA  $*"; }
blad()  { echo "BŁĄD   $*"; BLAD=1; }

# 1. Checkout
GAL=$(git branch --show-current); HEAD=$(git rev-parse --short HEAD)
BRUD=$(git status --porcelain | wc -l | tr -d ' ')
ZA=$(git rev-list --count HEAD..origin/main 2>/dev/null || echo "?")
ok "checkout $REPO, gałąź ${GAL:-(odłączona)} @ $HEAD, zmienionych plików $BRUD, za origin/main o $ZA (bez fetch)"

# 2. Serwer: czy na porcie tego checkoutu słucha proces z TEGO katalogu
PID=$(pid_portu)
if [ -z "$PID" ]; then
  blad "na porcie $PORT nic nie słucha. Start: bin/start (Bash z run_in_background)"
else
  CWD=$(cwd_procesu "$PID")
  if [ "$CWD" = "$REPO" ]; then ok "serwer $URL, pid $PID, z tego checkoutu"
  else blad "port $PORT trzyma pid $PID z katalogu '$CWD', nie z $REPO. Nie steruj nim."; fi
  KOD=$(curl -s -o /dev/null -w '%{http_code}' "$URL/")
  [ "$KOD" = "200" ] && ok "strona odpowiada 200" || blad "strona odpowiada $KOD"
fi

# 3. Przeglądarka
if [ -n "$PID" ]; then
  ADR=$("$B" url 2>/dev/null | tail -1)
  DEMONY=$(pgrep -f 'browse/src/server.ts' | wc -l | tr -d ' ')
  [ "$DEMONY" -le 1 ] && ok "daemonów gstack browse: $DEMONY" || uwaga "daemonów gstack browse: $DEMONY (dwa dają pozorne regresje wszystkiego)"
  case "$ADR" in
    "$URL"*) ok "karta na $ADR" ;;
    *) blad "karta przeglądarki na '$ADR', nie na $URL (bin/sesja przenosi i loguje)" ;;
  esac
  T=$(mktemp -d); trap 'rm -rf "$T"' EXIT
  printf '%s' "(async () => { const m = await import('/src/integrations/supabase/client.ts'); const r = await m.supabase.auth.getUser(); return r.data.user ? 'zalogowany: ' + r.data.user.email : 'niezalogowany'; })()" > "$T/kto.js"
  case "$ADR" in "$URL"*)
    KTO=$("$B" eval "$T/kto.js" 2>&1 | tail -1)
    case "$KTO" in zalogowany:*) ok "$KTO" ;; *) blad "sesja: ${KTO:-brak odpowiedzi} (bin/sesja <email>)" ;; esac
    BLEDY=$("$B" console --errors 2>/dev/null | grep -c '\[error\]' || true)
    [ "${BLEDY:-0}" -eq 0 ] && ok "konsola bez błędów od logowania" || uwaga "błędów w konsoli od logowania: $BLEDY (\$B console --errors | grep '\[error\]')"
  esac
fi

# 4. Mapa: które obszary przejść. Tylko te, których dotyka zmiana (koszt weryfikacji idzie za diffem).
TSV="$MAPA_DIR/przejscia.tsv"
timeout 20 git fetch -q origin main 2>/dev/null || uwaga "git fetch origin main nie przeszedł: porównanie z origin/main może być nieświeże"
pasuje() { # plik, lista ścieżek obszaru (katalog, plik albo glob)
  local f="$1" p; shift
  for p in "$@"; do case "$f" in $p|$p/*) return 0 ;; esac; done; return 1
}
ZMIENIONE=$( { git diff --name-only origin/main...HEAD 2>/dev/null; git status --porcelain | cut -c4-; } | sort -u)
if [ -f "$TSV" ]; then
  DO_PRZEJSCIA=""
  while IFS=$'\t' read -r OBSZAR SCIEZKI SHA DATA; do
    [ -n "${1:-}" ] && [ "$1" != "$OBSZAR" ] && continue
    # shellcheck disable=SC2086
    TWOJE=$(echo "$ZMIENIONE" | while read -r f; do [ -n "$f" ] && pasuje "$f" $SCIEZKI && echo "$f"; done)
    [ -n "$TWOJE" ] && DO_PRZEJSCIA="$DO_PRZEJSCIA $OBSZAR"
    if [ "$SHA" != "-" ]; then
      # shellcheck disable=SC2086
      if ! CUDZE=$(git log --format='%h %an: %s' "$SHA"..origin/main -- $SCIEZKI 2>&1); then
        blad "$OBSZAR: git log nie przeszedł (rewizja $SHA nieznana?)"
      elif [ -n "$CUDZE" ]; then
        uwaga "$OBSZAR: $(echo "$CUDZE" | wc -l | tr -d ' ') commit(y) na main od przejścia $DATA. Przejdź jego wpisy przed swoją robotą."
        [ -n "${1:-}" ] && echo "$CUDZE" | sed 's/^/         /'
      elif [ -n "${1:-}" ]; then ok "$OBSZAR: bez cudzych zmian od przejścia $DATA ($SHA)"
      fi
    elif [ -n "${1:-}" ]; then uwaga "$OBSZAR: nigdy nie przeszedł na żywo"; fi
  done < "$TSV"
  if [ -n "$DO_PRZEJSCIA" ]; then ok "zmiana dotyka obszarów:$DO_PRZEJSCIA (przejdź tylko je)"
  elif [ -n "$ZMIENIONE" ]; then uwaga "zmienione pliki nie należą do żadnego obszaru mapy: weryfikacja bez mapy albo brak wiersza w przejscia.tsv"
  else ok "brak zmian względem origin/main"; fi
fi

[ $BLAD -eq 0 ] && echo "WYNIK  instancja zdatna do sterowania" || echo "WYNIK  NIE steruj, napraw błędy wyżej"
exit $BLAD
