#!/usr/bin/env python3
"""Przelot foremana 2.0 bez terminala: `claude -p` z agentami floty, hookami brygadzisty
(Stop: stop-check, PreToolUse: straz), budżetem i zapisem wyniku do katalogu przelotu.
Mac nie zaśnie (caffeinate).

  run --repo <dir> --slug <nazwa> --plan <plan.md> [--budget 40] [--model opus]
      [--mandate merge,deploy] [--unattended] [--max-live 3] [--effort high] [--dry]
  run --resume <run-id> [--budget 20]   # nowa tura w sesji runnera (run.json: runner_session);
                                        # bez --budget dostaje resztę budżetu przelotu

Sesja `claude -p` dostaje UUID wyznaczony tutaj i zapisany przed startem jako właściciel
przelotu (`foreman2 session --runner`); runner odpalony z Basha innej sesji nie przekazuje
CLI jej id.

Wynik: ~/.foreman2/runs/<id>/sessions/<ts>.json (pełne JSON `claude -p`), koszt
dopisany do run.json, meldunek `foreman2 status` na stdout. Kod wyjścia = claude."""
import argparse
import datetime as dt
import json
import os
import shutil
import subprocess
import sys
import uuid

TU = os.path.dirname(os.path.abspath(__file__))
F2 = os.path.join(TU, "foreman2")
SKILL_DIR = os.path.dirname(TU)
SKILL = os.path.join(SKILL_DIR, "SKILL.md")
HOME = os.path.expanduser(os.environ.get("FOREMAN2_HOME") or "~/.foreman2")


def env_bez_sesji():
    """Środowisko bez id sesji rodzica: runner pisze stan jak terminal człowieka, a `claude -p`
    dostaje własny UUID."""
    env = dict(os.environ, FOREMAN2_HOME=HOME)
    for k in ("CLAUDE_CODE_SESSION_ID", "CLAUDE_SESSION_ID"):
        env.pop(k, None)
    return env


def f2(*a, run=None, check=True):
    cmd = [sys.executable, "-I", F2] + (["--run", run] if run else []) + list(a)
    r = subprocess.run(cmd, capture_output=True, text=True, env=env_bez_sesji())
    if check and r.returncode:
        sys.exit(f"{' '.join(a)}: {r.stderr.strip()}")
    return r.stdout.strip()


def preflight():
    """Braki, które unieważniłyby przelot: bez `claude` nic nie ruszy, bez `jq` strażnik floty
    odmawia każdej komendy, strażnik bez bitu wykonania nie odpala się wcale."""
    braki = []
    if not shutil.which("claude"):
        braki.append("brak `claude` na PATH")
    if not shutil.which("jq"):
        braki.append("brak `jq` (bramka-floty.sh odmówi każdej komendy agenta)")
    bramka = os.path.join(TU, "bramka-floty.sh")
    if not os.access(bramka, os.X_OK):
        braki.append(f"{bramka} bez bitu wykonania")
    return braki


def tresc_skilla():
    """Treść SKILL.md bez frontmatter, ze ścieżkami wskazującymi ten katalog (skill nieinstalowany)."""
    with open(SKILL) as f:
        t = f.read()
    t = t.split("\n---\n", 1)[1] if t.startswith("---\n") else t
    return t.replace("$HOME/.claude/skills/foreman2", SKILL_DIR) + f"\n\nKatalog skilla (BRIEF.md, BEZ-NADZORU.md, POSTMORTEM.md): {SKILL_DIR}\n"


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--repo", default=".")
    ap.add_argument("--slug")
    ap.add_argument("--plan")
    ap.add_argument("--resume", help="id przelotu do wznowienia")
    ap.add_argument("--budget", type=float)
    ap.add_argument("--model", default="opus")
    ap.add_argument("--effort", default="high")
    ap.add_argument("--mandate")
    ap.add_argument("--unattended", action="store_true")
    ap.add_argument("--max-live", type=int, default=3)
    ap.add_argument("--prompt", help="dodatkowe zdanie do promptu (np. zakres testu)")
    ap.add_argument("--dry", action="store_true", help="pokaż komendę, nie uruchamiaj")
    a = ap.parse_args()

    braki = preflight()
    if braki and not a.dry:
        sys.exit("preflight: " + "; ".join(braki))

    budzet = a.budget
    if a.resume:
        rid = a.resume
        d = json.loads(f2("status", "--json", run=rid))
        if d["state"] == "cancelled":
            sys.exit(f"przelot {rid} anulowany; nowy przelot przez run --slug/--plan")
        repo = d["repo"]
        if budzet is None and d.get("budget_usd"):
            budzet = round(d["budget_usd"] - ((d.get("cost") or {}).get("usd_total") or 0), 2)
            if budzet <= 0:
                sys.exit(f"budżet przelotu wyczerpany ({d['budget_usd']} USD); podaj --budget")
        prompt = (f"Wznów przelot {rid} foremana 2.0: najpierw `foreman2 --run {rid} resume`, potem kontynuuj "
                  f"od stanu w pliku (front, decyzje, dowody nieaktualne). Agenci poprzedniej sesji nie są osiągalni "
                  f"z tej sesji: zadania running wznawiasz nowym wykonawcą z worktree i SHA z rejestru. " + (a.prompt or ""))
        poprzednia = d.get("runner_session")
    else:
        if not (a.slug and a.plan):
            ap.error("--slug i --plan (albo --resume)")
        repo = os.path.abspath(a.repo)
        args = ["create", "--repo", repo, "--slug", a.slug, "--plan", os.path.abspath(a.plan), "--max-live", str(a.max_live)]
        if budzet:
            args += ["--budget", str(budzet)]
        if a.mandate:
            args += ["--mandate", a.mandate]
        if a.unattended:
            args += ["--unattended"]
        rid = f2(*args)
        poprzednia = None

    skill_zainstalowany = os.path.isdir(os.path.expanduser("~/.claude/skills/foreman2"))
    if not a.resume:
        naglowek = (f"/foreman2 {os.path.abspath(a.plan)}" if skill_zainstalowany else
                    "Działasz według poniższego skilla (treść SKILL.md foremana 2.0).\n\n" + tresc_skilla() + "\n\n---\n")
        prompt = (f"{naglowek}\nPrzelot {rid} jest już utworzony (`foreman2 status`); plan: {os.path.abspath(a.plan)}. "
                  f"Tryb bez nadzoru: {'tak, czytasz BEZ-NADZORU.md przed pierwszym spawnem' if a.unattended else 'nie'}. "
                  f"Mandat: {a.mandate or 'brak (PR bez merge i deployu)'}. Narzędzie stanu: `python3 {F2}`. " + (a.prompt or ""))

    kat = os.path.join(HOME, "runs", rid)
    os.makedirs(os.path.join(kat, "sessions"), exist_ok=True)
    agents = os.path.join(kat, "agents.json")
    with open(agents, "w") as f:
        f.write(subprocess.run([sys.executable, "-I", os.path.join(TU, "agents-json")], capture_output=True, text=True, check=True).stdout)
    settings = os.path.join(kat, "settings.json")
    ustawienia = {"env": {"FOREMAN2_HOME": HOME}}
    if not skill_zainstalowany:  # zainstalowany skill rejestruje te same hooki z frontmatter; dubel liczyłby blokady podwójnie
        hak = lambda sub: [{"hooks": [{"type": "command", "command": f"FOREMAN2_HOME={HOME} python3 -I {F2} {sub}"}]}]
        ustawienia["hooks"] = {"Stop": hak("stop-check"),
                               "PreToolUse": [{"matcher": "Bash|Agent|Write|Edit|MultiEdit|NotebookEdit", **hak("straz")[0]}]}
    with open(settings, "w") as f:
        json.dump(ustawienia, f, indent=1)

    sid = poprzednia or str(uuid.uuid4())
    cmd = ["claude", "-p", prompt, "--permission-mode", "bypassPermissions", "--agents", agents, "--settings", settings,
           "--output-format", "json", "--model", a.model, "--effort", a.effort, "--name", f"foreman2 {rid}"]
    cmd += ["--resume", sid] if poprzednia else ["--session-id", sid]
    if budzet:
        cmd += ["--max-budget-usd", str(budzet)]
    if shutil.which("caffeinate"):
        cmd = ["caffeinate", "-i"] + cmd
    if a.dry:
        print(json.dumps({"run": rid, "cwd": repo, "budget": budzet, "preflight": braki, "cmd": cmd}, ensure_ascii=False, indent=1))
        return
    f2("session", "--runner", sid, run=rid)
    f2("log", "run", "start sesji claude -p", f"model {a.model}, budżet {budzet}", "", sid, run=rid)
    ts = dt.datetime.now().strftime("%Y%m%dT%H%M%S")
    wyj = os.path.join(kat, "sessions", f"{ts}.json")
    with open(wyj, "w") as out, open(wyj + ".err", "w") as err:
        r = subprocess.run(cmd, cwd=repo, stdout=out, stderr=err, env=env_bez_sesji(), stdin=subprocess.DEVNULL)
    try:
        with open(wyj) as f:
            wynik = json.load(f)
    except Exception:
        wynik = {}
    koszt = wynik.get("total_cost_usd")
    d = json.loads(f2("status", "--json", run=rid))
    cost = d.get("cost") or {}
    # bez num_turns i duration_ms: `claude -p` liczy je bez agentów w tle; tury i E daje `cost --scan`
    cost.setdefault("sessions", []).append({"ts": ts, "usd": koszt, "subtype": wynik.get("subtype"),
                                            "error": wynik.get("is_error"), "exit": r.returncode})
    cost["usd_total"] = round(sum((s.get("usd") or 0) for s in cost["sessions"]), 2)
    f2("cost", json.dumps(cost), run=rid)
    f2("cost", "--scan", run=rid, check=False)
    f2("log", "run", f"koniec sesji exit={r.returncode}", f"subtype={wynik.get('subtype')}", wyj, f"usd={koszt}", run=rid)
    print(f"sesja {sid} exit={r.returncode} subtype={wynik.get('subtype')} usd={koszt} wynik={wyj}")
    print(f2("status", run=rid, check=False))
    sys.exit(r.returncode)


if __name__ == "__main__":
    main()
