#!/usr/bin/env python3
"""Zamienia agents/*.md (frontmatter YAML + prompt) na JSON dla `claude --agents`.
Użycie: agents-json [katalog] > agents.json. Bez zależności (parser podzbioru YAML:
mapy, listy, skalary, wcięcie 2 spacje)."""
import json
import os
import re
import sys

SKILL_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


def skalar(v):
    v = v.strip()
    if v[:1] in "\"'" and v[-1:] == v[:1]:
        return v[1:-1]
    if v in ("true", "false"):
        return v == "true"
    if re.fullmatch(r"-?\d+", v):
        return int(v)
    return v


def yaml_blok(linie, i, wciecie):
    """Parsuje mapę albo listę od linii i na danym wcięciu. Zwraca (wartość, następna linia)."""
    if i >= len(linie):
        return None, i
    pierwsza = linie[i].lstrip()
    if pierwsza.startswith("- "):
        lista = []
        while i < len(linie):
            l = linie[i]
            w = len(l) - len(l.lstrip())
            if not l.strip():
                i += 1
                continue
            if w < wciecie or not l.lstrip().startswith("- "):
                break
            tresc = l.lstrip()[2:]
            if ":" in tresc and not tresc.startswith(("\"", "'")):
                # element-mapa: pierwsza para na tej linii, reszta głębiej
                linie[i] = " " * (w + 2) + tresc
                el, i = yaml_blok(linie, i, w + 2)
                lista.append(el)
            else:
                lista.append(skalar(tresc))
                i += 1
        return lista, i
    mapa = {}
    while i < len(linie):
        l = linie[i]
        if not l.strip():
            i += 1
            continue
        w = len(l) - len(l.lstrip())
        if w < wciecie or l.lstrip().startswith("- "):
            break
        if w > wciecie:
            sys.exit(f"niespodziewane wcięcie: {l!r}")
        k, _, v = l.strip().partition(":")
        if v.strip():
            mapa[k] = skalar(v)
            i += 1
        else:
            i += 1
            if i < len(linie):
                nast = linie[i]
                mapa[k], i = yaml_blok(linie, i, len(nast) - len(nast.lstrip()))
            else:
                mapa[k] = None
    return mapa, i


def agent(plik):
    with open(plik) as f:
        t = f.read()
    t = t.replace("$HOME/.claude/skills/foreman2", SKILL_DIR)  # skill może nie być zainstalowany (runner, lab)
    m = re.match(r"^---\n(.*?)\n---\n(.*)$", t, re.S)
    if not m:
        sys.exit(f"{plik}: brak frontmatter")
    fm, _ = yaml_blok(m.group(1).split("\n"), 0, 0)
    nazwa = fm.pop("name")
    if isinstance(fm.get("tools"), str):
        fm["tools"] = [x.strip() for x in fm["tools"].split(",") if x.strip()]
    fm["prompt"] = m.group(2).strip()
    return nazwa, fm


def main():
    kat = sys.argv[1] if len(sys.argv) > 1 else os.path.join(SKILL_DIR, "agents")
    out = {}
    for n in sorted(os.listdir(kat)):
        if n.endswith(".md"):
            k, v = agent(os.path.join(kat, n))
            out[k] = v
    json.dump(out, sys.stdout, ensure_ascii=False, indent=1)
    print()


if __name__ == "__main__":
    main()
